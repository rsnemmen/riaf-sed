# Editor and OS cruft
*~
*.bak
.DS_Store
.gdbtkinit
__pycache__/

# Compiled Fortran executables
/bin/

# IC lookup tables: tracked only in data/, ignored everywhere else
aomi*.dat
aomi2*.dat
romi*.dat
