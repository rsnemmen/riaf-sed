/fortran/ses5.dat
/fortran/spectrum.dat
/fortran/ssd.dat
/fortran/ssd_alone.dat
/fortran/x.dat
/fortran/hot*.dat

# Working-directory outputs from Perl wrappers
/perl/tmp.pl
/perl/*.gp
/perl/in.dat
/perl/out
/perl/out.dat
/perl/_ssd
/perl/bad.dat
/perl/ok.dat
/perl/spectrum
/perl/spec.dat
/perl/specstd
/perl/specr01
/perl/comptr01
/perl/comptstd
/perl/ses5.dat
/perl/spectrum.dat
/perl/spectrum_
/perl/spectrum_ssd
/perl/ssd_alone.dat
/perl/ssd_alone.dat_ssd
/perl/x.dat
/perl/output.dat
/perl/output_*.dat
/perl/outputs.dat
/perl/hot.dat
/perl/hottem.dat
/perl/run0*/
/perl/test/

# Working-directory outputs when running from tests/
/tests/artifacts/
/tests/in.dat
/tests/hot.dat
/tests/hottem.dat
/tests/x.dat
